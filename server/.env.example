PORT=5000
NODE_ENV=development
CLIENT_URL=https://nex-chat-wjpg.vercel.app
MONGO_URI=mongodb://127.0.0.1:27017/nexchat
JWT_SECRET=nexchat_secret_development_token_key_2026_987654321
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Pusher Channels (for Serverless Realtime)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2

# Email Notifications (Nodemailer - Gmail / SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=NexChat <noreply@nexchat.app>
# Optional custom SMTP host (omit if using standard Gmail)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

